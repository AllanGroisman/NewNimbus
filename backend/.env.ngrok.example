# ─── Overrides do MODO NGROK (template) ──────────────────────────────
# Copie para backend/.env.ngrok (que é gitignored) e edite:
#   cp backend/.env.ngrok.example backend/.env.ngrok
# Carregado por cima do backend/.env quando NIMBUS_MODE=ngrok
# (deploy/ngrok_start.sh).
#
# Domínio ESTÁTICO da SUA conta ngrok (cada máquina de teste usa o seu).
# Enquanto estiver com SEU-DOMINIO o ngrok_start.sh aborta.
PUBLIC_BASE_URL=https://SEU-DOMINIO.ngrok-free.app

# Máquina de dev começando do ZERO: desliga o Backblaze por completo
# (bucket vazio = "Backblaze não configurado" — não lê nem escreve backups).
BACKUP_S3_BUCKET=
BACKUP_REMOTE_AUTO_UPLOAD=0

# Máquina de testes que precisa LER os backups de produção (sem nunca escrever):
# comente o BACKUP_S3_BUCKET= acima e use o prefixo de produção.
#BACKUP_S3_PREFIX=nimbus/

# Stripe (modo teste): se criar um endpoint de webhook próprio pro domínio acima,
# coloque o signing secret dele aqui (ou use `stripe listen`).
#STRIPE_WEBHOOK_SECRET=
