# Modelo do backend/.env — copie para .env e preencha.
#
# Este arquivo (o .example) é versionado; o .env real NÃO é, porque guarda senha
# de banco, chaves do Stripe/Backblaze e credenciais de e-mail. Ao migrar de
# máquina, copie o .env do servidor atual por scp em vez de preencher na mão.
#
#   cp .env.example .env && chmod 600 .env
#
# Existe também um .env na RAIZ do projeto, separado deste, com as senhas do
# Postgres e do Redis lidas pelo docker-compose.yml. As senhas precisam bater
# com DATABASE_URL e REDIS_URL abaixo.

# ── Banco e fila ────────────────────────────────────────────────────────────
# A senha tem que ser a mesma do POSTGRES_PASSWORD no .env da raiz.
DATABASE_URL=postgresql://nimbus:TROQUE_ESTA_SENHA@localhost:5432/nimbus?schema=public
QUEUE_BACKEND=redis
# A senha tem que ser a mesma do REDIS_PASSWORD no .env da raiz.
REDIS_URL=redis://:TROQUE_ESTA_SENHA@localhost:6379

# ── Acesso e admin ──────────────────────────────────────────────────────────
# E-mails que sempre têm papel de admin (separados por vírgula).
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
# Conta de admin criada no primeiro boot, se ainda não existir.
DEFAULT_ADMIN_EMAIL=
# Usada SÓ na criação da conta. Depois disso, troque a senha pela interface —
# o valor aqui deixa de ter efeito e pode (deve) ficar em branco.
# Mínimo 8 caracteres, com maiúscula, minúscula e número.
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Admin

# ── E-mail (verificação de conta e reset de senha) ──────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Servidor ────────────────────────────────────────────────────────────────
# Usada também como origem permitida no CORS — em produção não pode faltar.
PUBLIC_BASE_URL=https://seu-dominio.com
NODE_ENV=production
LOG_LEVEL=info
PORT=3001

# ── Backup remoto (Backblaze B2, compatível com S3) ─────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=nimbus/
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# Cifra dos dumps na nuvem (64 chars hex). GUARDE UMA CÓPIA FORA DO SERVIDOR!
BACKUP_ENC_KEY=
# Retenção remota (defaults): tudo das últimas 48h + 1 por dia até 30 dias
#BACKUP_RETAIN_REMOTE_HOURS=48
#BACKUP_RETAIN_REMOTE_DAYS=30
# Alertas do monitor de backup (horas)
#BACKUP_ALERT_LOCAL_MAX_H=3
#BACKUP_ALERT_REMOTE_MAX_H=6

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_TRIAL_FEE=
