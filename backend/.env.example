# ─── Postgres (obrigatório) ──────────────────────────────────────────
DATABASE_URL=postgresql://nimbus:nimbus_dev@localhost:5432/nimbus?schema=public

# ─── Fila (Fase 2) ───────────────────────────────────────────────────
# "memory" (legado, default) — sem persistência, sem retry, comportamento atual.
# "redis"  — BullMQ. Persistência de jobs, retry com backoff, observabilidade.
QUEUE_BACKEND=memory

# Redis (usado quando QUEUE_BACKEND=redis)
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────
# JWT_SECRET=...           # se omitido, gera/lê de AppConfig no Postgres
# ADMIN_EMAILS=email1@x.com,email2@y.com

# ─── Afiliados ───────────────────────────────────────────────────────
# (opcionais — sobrescrevem config persistida)
# ML_AFFILIATE_TAG=...
# ML_AFFILIATE_COOKIE=...
# AMAZON_AFFILIATE_TAG=...

# ─── Hardening (Fase 0) ──────────────────────────────────────────────
# CORS allowlist. Vazio = aceita tudo (dev). Em prod, defina:
#   NIMBUS_CORS_ORIGINS=https://app.nimbus.com,https://*.nimbus.com
NIMBUS_CORS_ORIGINS=

# Logger — "info" em prod, "debug" em dev (default automático por NODE_ENV)
# LOG_LEVEL=info

# Ambiente — "production" ativa logs JSON e níveis mais altos
# NODE_ENV=development

# ─── Observabilidade (Fase 4) ────────────────────────────────────────
# Sentry — vazio = capture desativado. Pra ativar:
#   1) cria projeto em sentry.io (free tier de 5k erros/mês é suficiente pra começar)
#   2) cole o DSN abaixo
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_RELEASE=v1.2.3   # opcional — pra correlacionar erros com deploys

# ─── Backup remoto S3-compatível (opcional) ──────────────────────────
# Sem essas envs, npm run backup:remote sai com exit 0 sem fazer nada.
# Compatível com AWS S3, Backblaze B2, Wasabi, Cloudflare R2, MinIO.
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com   # B2 ex; AWS deixar vazio
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=nimbus-backups
# BACKUP_S3_PREFIX=nimbus/
# BACKUP_S3_KEY_ID=
# BACKUP_S3_SECRET=
# BACKUP_RETAIN_REMOTE=30   # quantos snapshots remotos manter

# ─── Billing (Stripe) ────────────────────────────────────────────────
# Chaves obtidas em https://dashboard.stripe.com/test/apikeys (modo test).
# Vazio = endpoints de billing desabilitados (retornam 501).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...     # opcional, hoje não usado (Checkout hosted)

# Webhook signing secret — obtido via `stripe listen` (dev) ou dashboard (prod)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dos 3 planos — criados no dashboard Stripe (BRL, recorrência mensal).
# Aceita também STRIPE_PRICE_BASIC_BRL/etc se quiser separar moedas no futuro.
# STRIPE_PRICE_BASIC=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...

# URLs de retorno do Checkout (frontend roda em 5173 em dev).
STRIPE_SUCCESS_URL=http://localhost:5173/?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/?checkout=cancel

# ─── Porta do backend ────────────────────────────────────────────────
PORT=3001
