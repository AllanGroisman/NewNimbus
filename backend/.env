# ─── ATENÇÃOO ─────────────────────────────────────────────────────────
# Este arquivo é versionado no repo (repo privado).
# Edite na máquina/VPS quando precisar trocar uma chave, depois:
#   pm2 restart nimbus-backend nimbus-worker

# ─── Postgres ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nimbus:nimbus_dev@localhost:5432/nimbus?schema=public

# ─── Fila (BullMQ) ───────────────────────────────────────────────────
# "redis" em prod (worker dedicado + retry). "memory" só em dev single-proc.
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────
# JWT_SECRET=...           # se omitido, gera/lê de AppConfig no Postgres
ADMIN_EMAILS=allangroisman@gmail.com

# Google Sign-In (opcional). Pegue em https://console.cloud.google.com → APIs & Services → Credentials
# → "Create OAuth client ID" → tipo "Web application".
# Authorized JavaScript origins: http://localhost:5173 (dev) e seu dominio (prod)
# O MESMO valor precisa estar no frontend como VITE_GOOGLE_CLIENT_ID.
# Sem isso, o botão "Entrar com Google" fica oculto na UI.
GOOGLE_CLIENT_ID=688324907940-sf143mv4afvqta4thlfln0cd0v91tg4n.apps.googleusercontent.com

# Conta admin garantida — recriada/sincronizada a cada boot.
# ATENÇÃO: a senha é FORÇADA a cada boot — se você trocar pela UI,
# a troca volta no próximo restart. Pra trocar de verdade, edite aqui.
DEFAULT_ADMIN_EMAIL=allangroisman@gmail.com
DEFAULT_ADMIN_PASSWORD=20051997
DEFAULT_ADMIN_NAME=Allan Groisman

# ─── Afiliados ───────────────────────────────────────────────────────
# (opcionais — sobrescrevem config persistida)
# ML_AFFILIATE_TAG=...
# ML_AFFILIATE_COOKIE=...
# AMAZON_AFFILIATE_TAG=...

# ─── Hardening ───────────────────────────────────────────────────────
# CORS allowlist. Vazio = aceita tudo (dev). Em prod, defina:
#   NIMBUS_CORS_ORIGINS=https://app.nimbus.com,https://*.nimbus.com
NIMBUS_CORS_ORIGINS=

# Ambiente e logger
NODE_ENV=production
LOG_LEVEL=info

# ─── Observabilidade (opcional) ──────────────────────────────────────
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_RELEASE=v1.2.3

# ─── Backup remoto S3-compatível (opcional) ──────────────────────────
# BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=nimbus-backups
# BACKUP_S3_PREFIX=nimbus/
# BACKUP_S3_KEY_ID=
# BACKUP_S3_SECRET=
# BACKUP_RETAIN_REMOTE=30

# ─── Billing (Stripe) ────────────────────────────────────────────────
# Modo TEST. Pra subir live, troque pelas sk_live_/whsec_ correspondentes.
STRIPE_SECRET_KEY=sk_test_51TYbw45ULJncwJAevX5cWrxE43PnxQJ7IXG8SRdcLdh8qHcCd7xKDL8AiiCnSDmQVjArQXKgMJHaIUjzZAnpBRcv00WdpD9KNs
STRIPE_WEBHOOK_SECRET=whsec_a8a0ccd81b10a55c28a569dccc1443e6f364af4e087ad3f3004f514189b84fa2

STRIPE_PRICE_BASIC=price_1TYcDr5ULJncwJAeojB7fuBA
STRIPE_PRICE_PRO=price_1TYcE45ULJncwJAeVDrAlZ4r
STRIPE_PRICE_BUSINESS=price_1TYcEH5ULJncwJAegkpOioHs

# URLs de retorno do Checkout. Atualize quando subir pro domínio/ngrok:
#   STRIPE_SUCCESS_URL=https://seu-dominio/?checkout=success
#   STRIPE_CANCEL_URL=https://seu-dominio/?checkout=cancel
STRIPE_SUCCESS_URL=http://localhost:5173/?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/?checkout=cancel

# ─── Porta do backend ────────────────────────────────────────────────
PORT=3001
