# Overrides de E2E — carregado por config/loadEnv.js quando NIMBUS_MODE=e2e
# (com override:true, vence o .env). Mantém DEFAULT_ADMIN_* e demais valores do
# .env; só troca a INFRA e DESLIGA o Stripe pros testes de navegador.
# NODE_ENV=test é essencial: o .env força production, o que (via loadEnv override)
# religaria os rate-limiters de login/registro (skipLimitInTests checa NODE_ENV).
# Com ~20 logins na suíte/min isso causava 429 intermitentes ("login não carrega").
NODE_ENV=test
PORT=3101
QUEUE_BACKEND=memory
DATABASE_URL=postgresql://nimbus:nimbus_dev@localhost:5432/nimbus_test_e2e?schema=public
ADMIN_EMAILS=
LOG_LEVEL=warn
# Stripe desabilitado → UI mostra "Pagamentos desabilitados".
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# CORS: zera a allowlist de produção → backend libera qualquer origem (modo dev),
# permitindo o frontend de E2E em http://localhost:5273. Sem isso o backend
# responde "Origin não permitido" e o login pelo navegador falha.
PUBLIC_BASE_URL=
NIMBUS_CORS_ORIGINS=
