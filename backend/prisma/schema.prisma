// Schema Prisma — Nimbus
// Persistência única em Postgres. Os módulos storage/, catalog/, auth/, config/,
// billing/, scraping/affiliate-store/ leem e escrevem aqui via PrismaClient.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────
// Auth
// ────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  phone        String?
  // Uma conta por CPF. Só os 11 dígitos, sem pontuação. Nulo nas contas
  // criadas antes da regra — o índice único do Postgres ignora NULL, e o
  // sistema pede o documento na primeira entrada de quem ainda não tem.
  cpf          String?  @unique
  passwordHash String
  role         String   @default("user") // "user" | "admin"
  createdAt    DateTime @default(now())

  // Email verification — emailVerified=false bloqueia login até confirmar.
  // Contas Google nascem com emailVerified=true (Google já validou).
  emailVerified      Boolean   @default(false)
  emailVerifyToken   String?   @unique
  emailVerifyExpires DateTime?

  // Password reset por email.
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  // Troca de email pendente. O endereço novo só entra em `email` depois que a
  // pessoa clica no link enviado PARA ELE — assim um erro de digitação não
  // tranca a conta fora do login. Sem índice único: dois usuários podem ter
  // pedido o mesmo endereço; quem confirmar primeiro leva, o outro esbarra no
  // unique de `email` na hora de confirmar.
  pendingEmail        String?
  pendingEmailToken   String?   @unique
  pendingEmailExpires DateTime?

  // Suspensão administrativa.
  suspended   Boolean   @default(false)
  suspendedAt DateTime?

  // Versão da sessão: vai dentro do JWT e é conferida a cada request. Subir este
  // número invalida na hora todos os tokens já emitidos pro usuário — é o que
  // faz troca de senha, reset e suspensão expulsarem quem já estava logado.
  tokenVersion Int @default(0)

  state           UserState?
  groups          Group[]
  whatsappGroups  WhatsappGroup[]
  numbers         WhatsappNumber[]
  subscription    Subscription?
  affiliateConfig AffiliateConfig?

  @@map("users")
}

// Settings + metadata por usuário. Tudo que não é "ops" e não tem cardinalidade
// alta vai pra cá como jsonb. Groups/whatsappGroups/numbers são tabelas próprias.
model UserState {
  userId    String   @id
  settings  Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  // Pausa por plano — { groups: [id, …], numbers: ["id", …] }. Só o servidor
  // escreve (saveState toca apenas `settings`), então um PUT /api/state antigo
  // do frontend não apaga a marcação. Item pausado não envia e não conta
  // contra o limite do plano; o cliente escolhe quais ficam ativos.
  planPaused Json @default("{\"groups\":[],\"numbers\":[]}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_state")
}

// ────────────────────────────────────────────────────────────────────────
// Campanhas (groups)
// ────────────────────────────────────────────────────────────────────────

model Group {
  // ID legado é numérico (Date.now() do frontend). Mantemos como BigInt
  // pra não quebrar referências persistidas no frontend.
  id              BigInt  @id
  userId          String
  name            String
  messageTemplate String  @default("")
  paused          Boolean @default(false)

  // Campos estruturados como jsonb — formato e tamanho variáveis,
  // gravados em bloco pela UI:
  //   categories:        ["gamer", "bebe", ...]
  //   whatsappGroupIds:  ["120363...@g.us", ...]
  //   schedule:          { windows, cooldownValue, cooldownUnit }
  //   scraping:          { auto, sources, filters, mode, times }
  categories       Json @default("[]")
  whatsappGroupIds Json @default("[]")
  schedule         Json @default("{}")
  scraping         Json @default("{}")

  // Ops — só o scheduler/worker escreve. Coluna separada da config do usuário
  // elimina a race condition que hoje exige o hack OPS_FIELDS.
  sentToday   Int    @default(0)
  sentWeek    Int    @default(0)
  weekData    Json   @default("[0,0,0,0,0,0,0]")
  lastSend    String @default("—") // ISO ou "—" pra compat com UI atual
  avgDiscount String @default("—")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  history GroupHistory[]
  queue   GroupQueueItem[]
  pending GroupPendingItem[]

  @@index([userId])
  @@index([paused])
  @@map("groups")
}

// Histórico de envios — cardinalidade alta, vira tabela.
// Index (groupId, sentAt DESC) cobre a query principal: "últimos 200 do grupo".
model GroupHistory {
  id            BigInt   @id @default(autoincrement())
  groupId       BigInt
  productKey    String
  name          String
  link          String
  img           String?
  store         String?
  price         Float?
  originalPrice Float?
  discount      Int?
  sentAt        DateTime
  groupCount    Int      @default(1)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sentAt(sort: Desc)])
  @@index([groupId, productKey])
  @@map("group_history")
}

// Log de captura de campanhas de repasse — uma linha por (link, campanha)
// tentado, pra visibilidade no admin. Não entra em loadState/saveState;
// escrita é best-effort a partir de repasse/capture.js.
model RepasseCaptureLog {
  id                  BigInt   @id @default(autoincrement())
  groupId             BigInt
  userId              String
  waJid               String
  rawUrl              String
  resolvedUrl         String?
  store               String?
  sourceAllowed       Boolean?
  affiliateConfigured Boolean?
  scrapeOk            Boolean?
  productName         String?
  productImg          String?
  price               Float?
  originalPrice       Float?
  discount            Int?
  sold                Int?
  // Cupom lido da legenda do grupo líder (extractCoupon). Null = a mensagem não
  // trazia código nenhum — é o caso mais comum, e o log precisa distinguir os dois.
  coupon              String?
  outcome             String
  // Motivo em lista FECHADA (repasse/error-kinds.js) — é o que dá pra filtrar e
  // contar. NÃO substitui o `reason`: aquele continua sendo o texto humano, com o
  // detalhe do caso (qual campo faltou, qual mensagem o navegador viu).
  errorKind           String?
  // Até onde o link chegou no pipeline (STAGE em error-kinds.js). É o que permite
  // dizer "não chegou nessa etapa" em vez de mostrar um traço solto que parece bug.
  stage               String?
  reason              String?
  createdAt           DateTime @default(now())

  @@index([groupId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([errorKind, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  // Falta aqui, de propósito, o índice por (coupon, createdAt) que a aba
  // Admin › Cupom › Repasse usa: ele é PARCIAL (WHERE coupon IS NOT NULL), e o
  // Prisma não sabe declarar índice parcial. Ele mora só na migration
  // 20260831120000_repasse_log_coupon_index — declarar um @@index aqui criaria um
  // segundo índice, cheio, sobre a mesma tabela.
  @@map("repasse_capture_log")
}

// Fila de envio — itens já aprovados, esperando janela.
// `position` mantém ordem de chegada (FIFO). `payload` guarda o item completo.
model GroupQueueItem {
  id         BigInt   @id @default(autoincrement())
  groupId    BigInt
  productKey String
  position   Int      @default(0)
  payload    Json // item completo (name, link, price, etc) — usado no envio
  addedAt    DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, productKey])
  @@index([groupId, position])
  @@map("group_queue")
}

// Pendentes de aprovação manual.
model GroupPendingItem {
  id         BigInt   @id @default(autoincrement())
  groupId    BigInt
  productKey String
  payload    Json
  addedAt    DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, productKey])
  @@index([groupId])
  @@map("group_pending")
}

// ────────────────────────────────────────────────────────────────────────
// WhatsApp
// ────────────────────────────────────────────────────────────────────────

// Grupos de WhatsApp vinculados (resultado de listGroups + escolhas do usuário).
// Não confundir com Group (campanha) — aqui é o grupo do app WhatsApp em si.
model WhatsappGroup {
  // ID gerado pelo frontend (Date.now() ou uuid) — string pra aceitar ambos.
  id       String @id
  userId   String
  numberId String // sessão Baileys que controla esse grupo
  jid      String // ex "120363...@g.us"
  name     String
  metadata Json   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_groups")
}

// Números de WhatsApp do usuário (sessões Baileys).
model WhatsappNumber {
  id       String  @id
  userId   String
  label    String?
  phone    String?
  metadata Json    @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_numbers")
}

// Auth state Baileys em Postgres (useDatabaseAuthState).
// PK composta serializa por sessão+chave; valores codificados com BufferJSON.
model BaileysAuth {
  sessionId String // formato: "<userId>::<numberId>"
  keyType   String // "creds" | "pre-key" | "session" | "sender-key" | "app-state-sync-key" | "app-state-sync-version" | "sender-key-memory"
  keyId     String // "" para creds; ID específico pras outras
  value     String // JSON.stringify(v, BufferJSON.replacer) — Bytea seria ainda melhor mas complica migração
  updatedAt DateTime @default(now()) @updatedAt

  @@id([sessionId, keyType, keyId])
  @@index([sessionId])
  @@map("baileys_auth")
}

// ────────────────────────────────────────────────────────────────────────
// Catálogo global (compartilhado entre usuários)
// ────────────────────────────────────────────────────────────────────────

// Produto no catálogo. `key` é o productKey() — hash MD5 estável.
// Campos planos (price, discount, category, store) pra suportar índices SQL —
// o resto vai em `payload` (rating, sold, freeShipping, seller, etc).
model CatalogProduct {
  key           String   @id
  name          String
  link          String
  img           String?
  price         Float?
  originalPrice Float?
  discount      Int?
  store         String?
  category      String?
  rating        Float?
  sold          String?
  // Número de vendas já parseado do `sold` ("+1,5 mil vendidos" → 1500). Coluna
  // própria porque o filtro "vendas mínimas" precisa rodar no SQL: com o corte
  // em JS depois da query, o count() ignorava o filtro e a paginação mentia.
  soldCount     Int?
  // Campanha de cupom do ML que cobre este produto (ml_coupons.campaign_id).
  // Coluna, e não payload: o upsert do scraping reescreve o payload inteiro
  // (catalog/pg.js:toRow), então o cupom sumiria na rodada seguinte. Quem escreve
  // aqui é SÓ a sincronização de cupons (backend/coupons/pg.js) — o `toRow` nem
  // conhece este campo, e é isso que o mantém vivo entre as raspagens.
  couponCampaignId String?
  payload       Json     @default("{}")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([couponCampaignId])
  @@index([category, discount(sort: Desc)])
  @@index([store])
  @@index([lastSeenAt(sort: Desc)])
  @@index([discount(sort: Desc)])
  @@index([soldCount(sort: Desc)])
  @@map("catalog_products")
}

// ────────────────────────────────────────────────────────────────────────
// Configs globais (afiliado, scraper)
// ────────────────────────────────────────────────────────────────────────

// Key-value simples. Usado por admin-scraper.js (scraper-config).
// O afiliado por loja foi movido pra AffiliateConfig (per-user).
model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt

  @@map("app_config")
}

// Config de afiliado por usuário — cada um tem TAG/cookie/credenciais próprios.
// `data` é um jsonb com sub-objetos { ml: { tag, cookie, updatedAt },
// amazon: { tag, updatedAt }, shopee: { appId, appSecret, updatedAt } }.
model AffiliateConfig {
  userId    String   @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_config")
}

// ────────────────────────────────────────────────────────────────────────
// Billing (Stripe)
// ────────────────────────────────────────────────────────────────────────

// Assinatura por usuário (1:1). planId="free" significa sem acesso.
// Novos usuários nascem free/inactive — acesso só após o primeiro checkout (sem trial).
// stripeCustomerId/stripeSubscriptionId só ficam preenchidos após o primeiro checkout.
model Subscription {
  id                   String    @id @default(uuid())
  userId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  planId               String    @default("free") // "free" | "basic" | "pro" | "business"
  status               String    @default("inactive") // active | trialing | past_due | canceled | incomplete | unpaid | inactive
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  trialUsedAt          DateTime? // quando iniciou o trial de R$1 — nunca resetado (1 trial por conta)
  pastDueSince         DateTime? // início do atraso (past_due/unpaid) — base da carência de 3 dias
  stripeMode           String?   // "test" | "live" — modo do Stripe em que esta assinatura nasceu; NULL = linha sem Stripe

  // Checkout público (veio da landing page, sem conta): a Checkout Session é o
  // que liga o retorno do Stripe (/bem-vindo?session_id=…) à conta provisionada.
  // claimedAt trava o resgate em uso único — o session_id anda na URL.
  checkoutSessionId String?   @unique
  claimedAt         DateTime?
  signupSource      String? // "landing" | "app" — de onde veio a assinatura

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

// Idempotência de webhooks Stripe — Stripe pode reentregar o mesmo evento.
// Insere antes de processar; conflito = já processado, ignora.
model WebhookEvent {
  id          String   @id // event.id do Stripe (ex: "evt_…")
  type        String
  processedAt DateTime @default(now())

  @@index([type])
  @@map("webhook_events")
}

// Log dos e-mails transacionais (cobrança e segurança). Existe por dois
// motivos: `dedupeKey` UNIQUE impede o mesmo aviso de sair duas vezes quando o
// Stripe reentrega um evento ou o job de lembretes roda de novo, e o histórico
// responde o "não recebi o e-mail" do suporte.
//
// Sem FK para User de propósito: apagar a conta apaga em cascade, e o registro
// de que o e-mail foi enviado precisa sobreviver a isso.
model EmailLog {
  id        String    @id @default(uuid())
  userId    String?
  kind      String // "payment_failed" | "password_changed" | …
  dedupeKey String    @unique
  to        String
  status    String    @default("pending") // pending | sent | skipped_* | error
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([userId, kind, createdAt])
  @@map("email_log")
}

// ────────────────────────────────────────────────────────────────────────
// Cupons do Mercado Livre (a aba mercadolivre.com.br/cupons)
// ────────────────────────────────────────────────────────────────────────

// Um cupom da aba de cupons do ML, do jeito que o modelo da página entrega.
//
// `code` é a PALAVRA (tipo BRINQUEDOS), quando alguém descobriu qual é — e ela só
// se descobre TESTANDO no campo "Inserir código do cupom" (MlCouponCode). O token
// base64 que o ML manda no modelo NÃO é isso e não vira código público: fica no
// `raw`, para diagnóstico.
//
// `origin`: "page" = veio da varredura da aba; "code" = a campanha só apareceu
// porque uma palavra testada apontou para ela.
model MlCoupon {
  campaignId       String    @id @map("campaign_id")
  title            String
  subtitle         String?
  kind             String    @default("unknown") // percent | fixed | unknown
  value            Float?
  minPurchase      Float?
  maxDiscount      Float?
  scope            String    @default("campaign") // campaign | store
  sellerName       String?
  containerUrl     String?
  activated        Boolean   @default(false)
  activationType   String? // EU_QUERO | AUTOMATIC
  startsAt         DateTime?
  expiresAt        DateTime?
  expiresText      String?
  iconUrl          String?
  groupings        Json      @default("[]")
  sampleItems      Json      @default("[]")
  // Os MLBs das miniaturas do card (ml-cupons.js:sampleIdsFromTracking). São 4
  // produtos reais da vitrine que o ML entrega no próprio modelo da aba — o único
  // vínculo que existe para o cupom NÃO ativado, que não tem vitrine pra raspar.
  sampleItemIds    Json      @default("[]")
  raw              Json      @default("{}")
  firstSeenAt      DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  productsSyncedAt DateTime?
  code             String?
  origin           String    @default("page")

  products MlCouponProduct[]

  @@index([expiresAt])
  @@index([lastSeenAt(sort: Desc)])
  @@index([scope])
  @@index([code])
  @@map("ml_coupons")
}

// O vínculo cupom ↔ produto, colhido da vitrine do cupom (_Container_).
// `productKey` é o mesmo hash do catálogo (catalog/product-key.js), então dá pra
// cruzar com catalog_products sem depender da URL — que vem cheia de tracking.
model MlCouponProduct {
  id          BigInt   @id @default(autoincrement())
  campaignId  String   @map("campaign_id")
  productKey  String
  productUrl  String
  // De onde veio o vínculo, e é o que decide o peso dele:
  //   "vitrine" — raspado da vitrine (_Container_) no navegador: a lista COMPLETA.
  //   "landing" — a prévia (3-8 itens) que a landing de afiliado entrega sem
  //               navegador (scraping/ml-vitrine-landing.js).
  //   "amostra" — as 4 miniaturas do card do cupom (ml_coupons.sampleItemIds).
  // Os três provam que o produto ESTÁ coberto. Só "vitrine" é lista fechada, e
  // por isso só ele autoriza um "fora da vitrine" (coupons/quick-check.js).
  // As três são coleções separadas: cada uma só apaga a si mesma.
  origem      String   @default("vitrine")
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  coupon MlCoupon @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)

  @@unique([campaignId, productKey])
  @@index([productKey])
  @@map("ml_coupon_products")
}

// Palavra testada no campo "Inserir código do cupom" do ML e o que ele respondeu.
// É o dicionário palavra → campanha: a página não lista as palavras em lugar
// nenhum, então ele só cresce por teste (do admin ou do repasse).
model MlCouponCode {
  code         String   @id
  verdict      String // valid | invalid | indeterminado
  campaignId   String?  @map("campaign_id")
  message      String?
  responseCode String?  @map("response_code")
  source       String? // admin | repasse
  checkedAt    DateTime @map("checked_at")
  checkCount   Int      @default(1) @map("check_count")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at")
  raw          Json     @default("{}")

  @@index([campaignId])
  @@index([checkedAt])
  @@map("ml_coupon_codes")
}

// ────────────────────────────────────────────────────────────────────────
// Tutoriais (tela "Tutoriais" do app + Admin › Editar Tutoriais)
// ────────────────────────────────────────────────────────────────────────

// Antes as seções e tutoriais viviam hardcoded em frontend/src/pages/Tutoriais.jsx,
// então publicar um vídeo ou corrigir um título exigia deploy. Agora o admin edita
// pela tela e a página pública lê daqui.
model TutorialSection {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String   @default("")
  icon        String   @default("▶")
  sort        Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt

  tutorials Tutorial[]

  @@index([sort])
  @@map("tutorial_sections")
}

// `slug` é o que casa com TUTORIAL_IDS no front — as páginas de afiliado fazem
// deep-link por ele (onOpenTutorial("afiliado-ml")). Renomear slug quebra o link.
model Tutorial {
  id        String   @id @default(uuid())
  sectionId String   @map("section_id")
  slug      String   @unique
  title     String
  duration  String   @default("")
  content   String   @default("") // passo a passo em texto puro (renderizado pre-wrap)
  videoUrl  String   @default("") @map("video_url") // URL do YouTube; vazio = sem player
  sort      Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  section TutorialSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, sort])
  @@map("tutorials")
}
