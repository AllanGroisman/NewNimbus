{
  "name": "nimbus-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Bateria de testes automatizados do Nimbus (backend integration + jornadas)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run unit",
    "test:integration": "vitest run integration",
    "test:journey": "vitest run journey",
    "test:e2e:setup": "node e2e/global-setup.js",
    "test:e2e": "npm run test:e2e:setup && playwright test",
    "test:e2e:headed": "npm run test:e2e:setup && playwright test --headed",
    "test:e2e:ui": "npm run test:e2e:setup && playwright test --ui",
    "test:e2e:debug": "npm run test:e2e:setup && playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.9"
  }
}
