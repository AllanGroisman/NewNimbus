# Vite env vars — apenas variáveis prefixadas com VITE_ são expostas ao bundle.
#
# Google Sign-In (opcional). Pegue em https://console.cloud.google.com → APIs & Services
# → Credentials → "Create OAuth client ID" → tipo "Web application".
# Authorized JavaScript origins: http://localhost:5173 (dev), seu domínio (prod).
# Deve ser o MESMO valor de GOOGLE_CLIENT_ID no backend/.env.
# Sem isso, o botão "Entrar com Google" fica oculto.
VITE_GOOGLE_CLIENT_ID=688324907940-sf143mv4afvqta4thlfln0cd0v91tg4n.apps.googleusercontent.com
