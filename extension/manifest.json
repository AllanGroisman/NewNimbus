{
  "manifest_version": 3,
  "name": "Nimbus — cupons no meu Chrome",
  "version": "2.0.0",
  "description": "Faz as etapas de cupom do Mercado Livre (vitrine, lista, palavra) numa aba do seu Chrome, a pedido da tela de admin do Nimbus.",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "ponte.js"
      ],
      "matches": [
        "https://sistema.nimbuspromocoes.com/*",
        "https://nimbuspromocoes.com/*",
        "https://www.nimbuspromocoes.com/*",
        "https://*.ngrok-free.dev/*",
        "https://*.ngrok-free.app/*",
        "https://*.ngrok.dev/*",
        "https://*.ngrok.app/*",
        "https://*.ngrok.io/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "run_at": "document_idle"
    }
  ]
}
